# Environment Configuration for Autonomous AI System Investigator (RCAI)
ENVIRONMENT=development
LOG_LEVEL=INFO

API_GATEWAY_PORT=8000
ORDER_SERVICE_PORT=8001
PAYMENT_SERVICE_PORT=8002
DEPENDENCY_SERVICE_PORT=8003
BACKEND_API_PORT=8080
FRONTEND_PORT=3000

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rcai_db
POSTGRES_USER=rcai_user
POSTGRES_PASSWORD=rcai_password

REDIS_HOST=localhost
REDIS_PORT=6379

PROMETHEUS_PORT=9090
PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100
TEMPO_URL=http://localhost:3200

LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here

MAX_INVESTIGATION_TIME_SECONDS=90
MAX_TOOL_CALLS_PER_INVESTIGATION=20
MAX_HYPOTHESES=5
MAX_REMEDIATION_ATTEMPTS=2
