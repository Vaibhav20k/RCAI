# RCAI Environment Variables Template
ENVIRONMENT=development
PORT=8000
API_GATEWAY_PORT=8000
ORDER_SERVICE_PORT=8001
PAYMENT_SERVICE_PORT=8002
POSTGRES_HOST=localhost

# Telemetry Source Mode: "simulator" (default) or "live"
DATA_SOURCE=simulator

# Live Prometheus Telemetry & Credentials
PROMETHEUS_URL=http://localhost:9090
# PROMETHEUS_BEARER_TOKEN=
# PROMETHEUS_API_KEY=

# Live OpenTelemetry Collector & Credentials
OTEL_COLLECTOR_URL=http://localhost:4318
# OTEL_AUTH_TOKEN=

# Live Log Service (Loki / Elasticsearch) & Credentials
LOG_SERVICE_URL=http://localhost:3100
# LOG_SERVICE_AUTH_TOKEN=

# LLM Backend: "rule_based" (default), "ollama", or "hosted"
LLM_BACKEND=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_CONTEXT_WINDOW=8192
# HOSTED_LLM_API_KEY=
# HOSTED_LLM_BASE_URL=https://api.openai.com/v1
# HOSTED_LLM_MODEL=gpt-4o

# Stage 4: Real Infrastructure Remediation Execution Target ("simulated", "kubernetes", "docker", "webhook")
REMEDIATION_EXECUTION_TARGET=simulated
KUBERNETES_NAMESPACE=default
KUBECTL_BINARY_PATH=kubectl
DOCKER_BINARY_PATH=docker
# REMEDIATION_WEBHOOK_URL=http://localhost:9999/remediation/webhook
# REMEDIATION_WEBHOOK_SECRET=

# Stage 4: Live Outcome Verification Parameters
VERIFICATION_TIMEOUT_SECONDS=180.0
VERIFICATION_POLL_INTERVAL_SECONDS=5.0
VERIFICATION_MAX_ERROR_RATE=0.05
VERIFICATION_MAX_P99_MS=150.0

# Stage 5: Live Incident Webhook Ingestion & On-Call Escalation
# ALERTMANAGER_WEBHOOK_SECRET=
AUTO_START_INVESTIGATION_ON_ALERT=true
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# PAGERDUTY_WEBHOOK_URL=https://events.pagerduty.com/v2/enqueue

# Stage 6: Pre-Authorized Playbook Auto-Execution Parameters
AUTO_EXECUTE_ENABLED=false
AUTO_EXECUTE_PLAYBOOKS=optimize_db_index,restart_service,restart_workers,flush_cache
AUTO_EXECUTE_CONFIDENCE_THRESHOLD=0.90
AUTO_EXECUTE_REQUIRE_PROVENANCE=true

# Investigation Parameters & Safety Budgets
MAX_INVESTIGATION_TIME_SECONDS=120
MAX_TOOL_CALLS_PER_INVESTIGATION=10
MAX_HYPOTHESES=5
INVESTIGATION_MAX_TOOL_BUDGET=10
INVESTIGATION_CONFIDENCE_THRESHOLD=0.70

# CORS Configuration
ALLOWED_ORIGINS=https://rcai-console.vercel.app,http://localhost:3000,http://127.0.0.1:8000
